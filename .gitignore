# Quarto build cache — regenerated on every render.
/.quarto/

# NOTE: `docs/` is intentionally NOT ignored. GitHub Pages serves the site
# from that directory on the master branch, so the rendered output must be
# committed. See README.md.

# Full-resolution photo originals. Only the optimised derivatives
# (e.g. images/profile.jpg) belong in a public repo.
images/IMG_*.jpeg
images/IMG_*.jpg

.DS_Store
*.icloud

# Dropbox conflicted copies, in case one slips in
*conflicted copy*

**/*.quarto_ipynb
